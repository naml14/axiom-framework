# ============================================================
# Axiom — .gitignore
# ============================================================

# --- Build Output ---
demo/app.js
demo/static-out/
dist/

# --- Dependencies ---
node_modules/

# --- Local agent tooling (skills, locks) ---
.agents/
skills-lock.json

# --- Dev Scripts (internal exploration scripts, not part of public API) ---
scripts/
!scripts/
scripts/*
!scripts/*.ts
!scripts/templates/
!scripts/templates/**/*

# --- Editor / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Bun ---
bun.lock
bun.lockb
.bun/

# --- TypeScript ---
*.tsbuildinfo

# --- Testing ---
coverage/

# --- Debug ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Environment ---
.env
.env.local
.env.*.local

# --- Temporary ---
*.tmp
*.temp
.cache/

# --- Misc ---
*.bak
*.backup
*.old
*.orig
*.rej
# Local Pi runtime state
.pi/
.playwright-cli/
.playwright-mcp/
# Versioned on purpose: do NOT ignore .atl/ or .codegraph/.
# .codegraph/ ships only its own .gitignore; the index database stays local.
# Build/test artifacts from local dev
gh-run-latest-test.log
test_output.txt
